# Endpoint REST API Backend (kosongkan saat local dev agar proxy Vite localhost:8000 bekerja)
# Contoh production: https://api-whoami.yourdomain.com
VITE_API_URL=

# Endpoint WebSocket Backend (opsional, jika berbeda dari host REST API)
# Contoh production: wss://api-whoami.yourdomain.com/ws/telemetry
VITE_WS_URL=
